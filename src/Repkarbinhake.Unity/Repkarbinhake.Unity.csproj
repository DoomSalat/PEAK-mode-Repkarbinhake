<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Repkarbinhake.Unity</AssemblyName>
    <RootNamespace>Repkarbinhake.Unity</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GameDirectory Condition="'$(GameDirectory)' == ''">G:\SteamLibrary\steamapps\common\PEAK</GameDirectory>
    <ManagedDirectory>$(GameDirectory)\PEAK_Data\Managed</ManagedDirectory>
    <SandboxPluginsDirectory>$(MSBuildThisFileDirectory)..\..\Sandbox\Assets\Plugins\Repkarbinhake</SandboxPluginsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Repkarbinhake.Core\Repkarbinhake.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDirectory)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDirectory)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToSandbox" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)..\..\Sandbox\Assets')">
    <MakeDir Directories="$(SandboxPluginsDirectory)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)Repkarbinhake.Core.dll" DestinationFolder="$(SandboxPluginsDirectory)" />
  </Target>

</Project>
